# ─────────────────────────────────────────────
# Lumen 프로덕션 환경변수 템플릿
# cp .env.prod.example .env.prod  후 실제 값으로 교체
# ─────────────────────────────────────────────

# 공개 도메인 (Cloudflare Tunnel에서 설정한 hostname)
DOMAIN=lumen.yourdomain.com

# Cloudflare Tunnel 토큰
# Zero Trust 대시보드 → Networks → Tunnels → 해당 터널 → Configure → Install connector 에서 복사
CLOUDFLARE_TUNNEL_TOKEN=eyJ...

# PostgreSQL
POSTGRES_USER=labbase
POSTGRES_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
POSTGRES_DB=labbase
DATABASE_URL=postgresql+psycopg://labbase:CHANGE_THIS_STRONG_PASSWORD@postgres:5432/labbase

# Supabase
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# 앱 보안키 (랜덤 64자 이상 권장)
SECRET_KEY=CHANGE_THIS_SECRET_KEY

# AI
ANTHROPIC_API_KEY=sk-ant-...

# 인증 (프로덕션은 반드시 false)
DEV_BYPASS_AUTH=false
NEXT_PUBLIC_DEV_BYPASS_AUTH=false
