# ──────────────────────────────────────────────
# Railway Environment Variables (Backend)
# Railway Dashboard → Service → Variables에 등록
# ──────────────────────────────────────────────

# PostgreSQL — Railway PostgreSQL 플러그인 추가 시 DATABASE_URL 자동 주입
DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Redis — Railway Redis 플러그인 추가 시 REDIS_URL 자동 주입
REDIS_URL=redis://default:password@host:6379

# App
SECRET_KEY=your_random_secret_key_min_32_chars
ANTHROPIC_API_KEY=sk-ant-...

# ⚠️ 반드시 false — true이면 인증 우회됨
DEV_BYPASS_AUTH=false

# 프론트엔드 Vercel 도메인 (배포 후 실제 도메인으로 교체)
ALLOWED_ORIGINS=https://your-app.vercel.app
